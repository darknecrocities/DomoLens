{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "landing": {
      "root": "apps/landing",
      "framework": "vite"
    },
    "engine": {
      "root": "engine",
      "entrypoint": "api/index.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "engine"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "landing"
      }
    }
  ]
}
